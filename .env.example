# ============================================
# AetherStay 环境变量配置
# 复制本文件为 .env 后再修改：
#   cp .env.example .env
# ============================================

# --- 应用 ---
# 调试模式：生产环境设为 false
DEBUG=true

# JWT 签名密钥：生产环境必须替换为 64 字节随机串
#   python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# --- 数据库 ---
# MySQL 异步连接串（Docker 内使用 @mysql:3306）
# 注意：本地开发时 Docker MySQL 映射端口为 3307
DATABASE_URL=mysql+aiomysql://aetherstay:aetherstay@localhost:3307/aetherstay

# --- 跨域 ---
# 允许的前端源（JSON 字符串数组）
# 生产环境请替换为实际域名，如 ["https://hotel.example.com"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- JWT ---
# Access Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh Token 有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 预订 ---
# 预订 Hold 超时时间（分钟）：客户锁房后需在此时间内完成支付
HOLD_TTL_MINUTES=15
# 过期 Hold 扫描间隔（分钟）：APScheduler 定时任务执行周期
HOLD_RELEASE_INTERVAL_MINUTES=1

# --- 安全 ---
# Cookie Secure 标志：生产环境（HTTPS）必须设为 true
COOKIE_SECURE=false

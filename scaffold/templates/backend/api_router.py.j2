@router.put("/{{ '{' }}{{ snake }}_id{{ '}' }}", response_model={{ pascal }}Response)
async def update_{{ snake }}(
    {{ snake }}_id: int,
    data: {{ pascal }}Update,
    db: Annotated[AsyncSession, Depends(get_db)],
    current_user: Annotated[CurrentUser, Depends(get_current_user)],
):
    """Update an existing {{ snake }}."""
    obj = await db.get({{ pascal }}, {{ snake }}_id)
    if not obj:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="{{ pascal }} not found")

    for field, value in data.model_dump(exclude_unset=True).items():
        setattr(obj, field, value)

